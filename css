
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background-color: #f4f7fb;
    color: #222;
}

.navbar {
    background-color: #1e3a8a;
    color: white;
    padding: 20px 50px;
}

.navbar h2 {
    font-size: 24px;
}


.welcome {
    min-height: 85vh;
    display: flex;
    align-items: center;
    justify-content: space-around;
    gap: 40px;
    padding: 50px;
}

.welcome-content {
    max-width: 550px;
}

.welcome-content h1 {
    font-size: 45px;
    color: #1e3a8a;
    margin-bottom: 20px;
}

.welcome-content p {
    font-size: 18px;
    line-height: 1.6;
    margin-bottom: 30px;
}

.welcome-image img {
    width: 450px;
    height: 300px;
    object-fit: cover;
    border-radius: 15px;
}

/* Button */

.btn {
    display: inline-block;
    background-color: #1e3a8a;
    color: white;
    text-decoration: none;
    border: none;
    padding: 12px 25px;
    border-radius: 8px;
    font-size: 16px;
    cursor: pointer;
}

.btn:hover {
    background-color: #172554;
}

/* Footer */

footer {
    text-align: center;
    background-color: #1e3a8a;
    color: white;
    padding: 15px;
}

/* Login Page */

.login-container {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
}

.login-box {
    width: 400px;
    background-color: white;
    padding: 35px;
    border-radius: 12px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.15);
}

.login-box h1 {
    text-align: center;
    color: #1e3a8a;
    margin-bottom: 10px;
}

.login-box p {
    text-align: center;
    margin-bottom: 25px;
}

.login-box label {
    display: block;
    margin: 10px 0 5px;
    font-weight: bold;
}

.login-box input {
    width: 100%;
    padding: 12px;
    border: 1px solid #ccc;
    border-radius: 6px;
}

.login-box .btn {
    width: 100%;
    margin: 20px 0;
}

.login-box a {
    display: block;
    text-align: center;
    color: #1e3a8a;
    text-decoration: none;
}
body {
    margin: 0;
    min-height: 100vh;
    background-image: url("../assets/library image.jpg");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: fixed;
}